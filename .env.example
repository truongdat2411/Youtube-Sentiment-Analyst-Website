APP_NAME=YouTube Comment Sentiment Analysis
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/youtube_sentiment

YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_API_SERVICE_NAME=youtube
YOUTUBE_API_VERSION=v3
YOUTUBE_MAX_RESULTS_PER_PAGE=100
YOUTUBE_MAX_COMMENTS=500

MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=youtube-comment-sentiment
MLFLOW_REGISTERED_MODEL_NAME=sentiment-model

MODEL_NAME=wonrax/phobert-base-vietnamese-sentiment
MODEL_VERSION=sentiment-model-v1

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT (bat buoc doi JWT_SECRET_KEY tren production)
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Next.js (service `web` trong Docker) ---
# Trinh duyet nen goi API qua rewrite cung origin (tranh "Failed to fetch" / CORS):
# NEXT_PUBLIC_API_BASE_URL=/api/v1
# API_PROXY_TARGET=http://backend:8000
# Neu van dat NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1 thi trinh duyet phai cung origin
# (localhost) va backend phai cho CORS — khong on khi mo dashboard bang IP may.
